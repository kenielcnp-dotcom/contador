# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# Painel do Supabase > Project Settings > API Keys.
#
# Use SOMENTE a chave pública (começa com sb_publishable_ ou, no formato antigo, eyJ...).
# NUNCA coloque aqui sb_secret_..., service_role nem tokens sbp_... — elas ignoram o RLS.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
